+"""[local patch] Filename prefix + model info for saved generations.
+
+- The UI textbox ``filename_prefix`` (above the Generate button) is stored
+  here when the Generate button is pressed; saved files become
+  ``<prefix>_<random key>.mp3`` / ``.json``.
+- The JSON sidecar also records ``filename_prefix``, ``dit_model``,
+  ``lm_model`` and ``vae_checkpoint`` so a song can be recreated.
+- Loading a JSON restores prefix and model dropdowns when those keys exist
+  (old JSON files without them leave the current UI values untouched).
+"""
+
+import os
+import re
+import json
+
+import gradio as gr
+from loguru import logger
+
+_current_prefix = ""
+_INVALID_CHARS = re.compile(r'[<>:"/\\|?*\x00-\x1f]+')
+_MAX_PREFIX_LEN = 80
+
+
+def sanitize_filename_prefix(value) -> str:
+    """Return a filesystem-safe prefix ('' when empty)."""
+    if value is None:
+        return ""
+    text = _INVALID_CHARS.sub("_", str(value)).strip()
+    text = re.sub(r"\s+", "_", text)
+    text = re.sub(r"_{2,}", "_", text)
+    text = text[:_MAX_PREFIX_LEN].rstrip(" ._")
+    return text
+
+
+def set_filename_prefix(value) -> None:
+    global _current_prefix
+    _current_prefix = sanitize_filename_prefix(value)
+
+
+def get_filename_prefix() -> str:
+    return _current_prefix
+
+
+def build_file_stem(key: str, prefix: str) -> str:
+    return f"{prefix}_{key}" if prefix else key
+
+
+def collect_model_info(dit_handler, llm_handler) -> dict:
+    """Return the currently loaded DiT / LM / VAE names."""
+    info = {"dit_model": None, "lm_model": None, "vae_checkpoint": None}
+    try:
+        init = getattr(dit_handler, "last_init_params", None) or {}
+        cfg = init.get("config_path")
+        if cfg:
+            info["dit_model"] = os.path.basename(os.path.normpath(str(cfg)))
+        if init.get("vae_checkpoint"):
+            info["vae_checkpoint"] = init.get("vae_checkpoint")
+    except Exception as exc:  # pragma: no cover - defensive
+        logger.warning(f"[filename_prefix] cannot read DiT model info: {exc}")
+    try:
+        if llm_handler is not None and getattr(llm_handler, "llm_initialized", False):
+            lm_cfg = getattr(llm_handler, "_last_initialize_config", None) or {}
+            lm = lm_cfg.get("lm_model_path")
+            if not lm and getattr(llm_handler, "_lm_full_model_path", None):
+                lm = llm_handler._lm_full_model_path
+            if lm:
+                info["lm_model"] = os.path.basename(os.path.normpath(str(lm)))
+    except Exception as exc:  # pragma: no cover - defensive
+        logger.warning(f"[filename_prefix] cannot read LM model info: {exc}")
+    return info
+
+
+def load_prefix_and_models(file_obj, dit_handler, llm_handler, current_dit=None):
+    """Return updates for (filename_prefix, config_path, lm_model_path, vae_checkpoint)
+    plus a flag: True when the DiT dropdown changes, so the config_path.change
+    handler keeps the steps/shift just loaded from the JSON."""
+    skip = (gr.skip(), gr.skip(), gr.skip(), gr.skip(), False)
+    if file_obj is None:
+        return skip
+    try:
+        path = file_obj.name if hasattr(file_obj, "name") else file_obj
+        with open(path, "r", encoding="utf-8") as f:
+            meta = json.load(f)
+    except Exception as exc:
+        logger.warning(f"[filename_prefix] cannot read JSON: {exc}")
+        return skip
+    if not isinstance(meta, dict):
+        return skip
+
+    prefix_upd = gr.skip()
+    if "filename_prefix" in meta:
+        prefix_upd = sanitize_filename_prefix(meta.get("filename_prefix"))
+
+    current = collect_model_info(dit_handler, llm_handler)
+    to_reinit = []
+
+    dit_upd = gr.skip()
+    dit = meta.get("dit_model")
+    if dit:
+        try:
+            choices = dit_handler.get_available_acestep_v15_models()
+        except Exception:
+            choices = []
+        if dit in choices:
+            dit_upd = dit
+            if dit != current["dit_model"]:
+                to_reinit.append(f"DiT: {dit}")
+        else:
+            gr.Warning(f"DiT model '{dit}' from the JSON was not found in checkpoints / Modello DiT non trovato.")
+
+    lm_upd = gr.skip()
+    lm = meta.get("lm_model")
+    if lm:
+        try:
+            choices = llm_handler.get_available_5hz_lm_models() if llm_handler else []
+        except Exception:
+            choices = []
+        if lm in choices:
+            lm_upd = lm
+            if lm != current["lm_model"]:
+                to_reinit.append(f"LM: {lm}")
+        else:
+            gr.Warning(f"LM model '{lm}' from the JSON was not found in checkpoints / Modello LM non trovato.")
+
+    vae_upd = gr.skip()
+    vae = meta.get("vae_checkpoint")
+    if vae:
+        try:
+            from acestep.model_downloader import list_available_vae_variants
+            vae_choices = list_available_vae_variants()
+        except Exception:
+            vae_choices = [vae]
+        if vae in vae_choices:
+            vae_upd = vae
+            if current["vae_checkpoint"] and vae != current["vae_checkpoint"]:
+                to_reinit.append(f"VAE: {vae}")
+
+    if to_reinit:
+        gr.Warning(
+            "The JSON uses different models from the loaded ones ("
+            + ", ".join(to_reinit)
+            + "). Dropdowns set: press 'Initialize Service' before generating. / "
+            "Modelli diversi: premi 'Initialize Service' prima di generare."
+        )
+    dit_changes = isinstance(dit_upd, str) and dit_upd != current_dit
+    return prefix_upd, dit_upd, lm_upd, vae_upd, dit_changes
+
+
+def update_model_type_settings_keeping_loaded(config_path, current_mode, keep_loaded_values):
+    """Run the DiT model-type defaults; after a JSON load keep loaded steps/shift.
+
+    Returns the update_model_type_settings updates followed by False (flag reset).
+    """
+    from acestep.ui.gradio.events.generation.model_config import update_model_type_settings
+
+    updates = list(update_model_type_settings(config_path, current_mode))
+    if keep_loaded_values:
+        for index in (0, 3):  # inference_steps, shift
+            update = dict(updates[index])
+            update.pop("value", None)
+            updates[index] = update
+    return (*updates, False)
